# Groq — handles both LLM and Whisper STT
# Get from: https://console.groq.com
GROQ_API_KEY=

# Supabase — Postgres + pgvector + auth
# Get from your project's Settings → API page
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Doctor matching (optional) ───────────────────────────────────────────────
# Matching, verification and analysis use public APIs (NPPES, CMS, NLM) and need
# no keys. Without Supabase, applications/referrals are stored in ./data/store.json.
# Protects /api/admin/* in production (required when NODE_ENV=production).
ADMIN_TOKEN=
# Groq vision model used to OCR photos of documents (needs GROQ_API_KEY).
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Force local Tesseract OCR even when GROQ_API_KEY is set.
# OCR_ENGINE=local
# Where HTTP/OCR caches live (default: system temp dir).
# CACHE_DIR=
